# CoinBrief 환경변수 (이름만. 실제 값은 루트 .env / .env.local 에 넣는다. 둘 다 git 에서 제외됨)
# 로컬: web(Vite)과 api(Express)가 같은 루트 .env, .env.local 을 읽는다.
#       web 은 VITE_ 로 시작하는 것만 브라우저 번들에 노출한다. 비밀 값에는 VITE_ 를 붙이지 말 것.

# ───────── web (브라우저, VITE_*) ─────────
# 소켓 중계 서버 주소 (로컬: http://localhost:4000)
VITE_WEBSOCKET_URL=

# Firebase 웹 설정 (공개 키)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# 카카오 로그인 (redirect_uri 는 코드에서 `${origin}/kakaocb` 로 만든다. 카카오 콘솔에 등록 필요)
VITE_KAKAO_API_KEY=
VITE_KAKAO_TOKEN_URL=

VITE_IMAGE_URL=

# 로그인 화면의 "테스트 계정 로그인"용. 브라우저 번들에 그대로 들어간다(의도된 것).
VITE_TEST_EMAIL=
VITE_TEST_PW=

# ───────── api (서버 전용, api/ Express) ─────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
UPBIT_API_URL=

EXCHANGE_API_URL=
EXCHANGE_API_KEY=

GMAIL_APP_EMAIL=
GMAIL_APP_PASSWORD=
# PORT=4100

# ───────── 소켓 중계 서버 (server/, 별도 실행) ─────────
# server/ 폴더에서 읽는다. 루트 .env 와는 별개.
# UPBIT_WEBSOCKET_URL=
# SERVER_PORT=4000   (PORT 도 인식)
# 허용 origin 은 server/server.js 의 ALLOWED_ORIGINS 에 하드코딩되어 있다.
